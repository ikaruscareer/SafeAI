{
  "mcp": {
    "version": "1.1",
    "auth": {"type": "oauth2"},
    "permissions": {"notes:read": true},
    "transports": ["https"],
    "endpoints": ["https://127.0.0.1:8443/mcp"],
    "resources": [],
    "servers": [
      {"name": "notes", "command": "npx @safeai/read-only-notes-server"}
    ],
    "tools": [
      {
        "name": "search_notes",
        "description": "Search note titles by keyword.",
        "parameters": {"query": {"type": "string", "maxLength": 100}}
      }
    ]
  }
}
